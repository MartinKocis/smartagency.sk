---
import Layout from '../layouts/Layout.astro';
---
<Layout>

  <!-- FLOATING NAV -->
  <nav class="fixed top-4 left-4 right-4 z-50 rounded-2xl border border-white/8 bg-[#030712]/70 backdrop-blur-2xl">
    <div class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between">
      <a href="/" class="font-black text-lg tracking-tight cursor-pointer">
        Smart<span class="text-indigo-400">Agency</span><span class="text-indigo-400">.</span>
      </a>
      <div class="hidden md:flex items-center gap-7 text-sm text-zinc-400">
        <a href="#pre-koho" class="hover:text-white transition-colors duration-200 cursor-pointer">Pre koho</a>
        <a href="#cena" class="hover:text-white transition-colors duration-200 cursor-pointer">Cena</a>
        <a href="#ako-to-funguje" class="hover:text-white transition-colors duration-200 cursor-pointer">Ako to funguje</a>
        <a href="#referencie" class="hover:text-white transition-colors duration-200 cursor-pointer">Referencie</a>
        <a href="#faq" class="hover:text-white transition-colors duration-200 cursor-pointer">Otázky</a>
      </div>
      <a href="#kontakt" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold px-5 py-2 rounded-xl transition-all duration-200 cursor-pointer shadow-lg shadow-indigo-900/40">
        Chcem to tiež →
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden pt-24">
    <div class="blob w-[600px] h-[600px] bg-indigo-600 top-[-150px] right-[-200px]" style="animation-duration:10s"></div>
    <div class="blob w-[450px] h-[450px] bg-violet-700 bottom-[-120px] left-[-120px]" style="animation-duration:13s;animation-delay:4s"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image:linear-gradient(white 1px,transparent 1px),linear-gradient(90deg,white 1px,transparent 1px);background-size:72px 72px"></div>

    <div class="relative max-w-5xl mx-auto px-6 py-32 text-center">

      <div class="inline-flex items-center gap-2 border border-indigo-500/25 bg-indigo-500/8 rounded-full px-4 py-1.5 text-xs font-semibold text-indigo-300 mb-10">
        <span class="relative flex w-2 h-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-60"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-indigo-400"></span>
        </span>
        Dostupný pre nových klientov · Slovensko & remote
      </div>

      <h1 class="font-black leading-[0.95] tracking-[-0.03em] mb-6" style="font-size:clamp(2.8rem,7.5vw,7rem)">
        Chceš predávať<br />
        <span class="gradient-text">online?</span><br />
        Postavím ti to.
      </h1>

      <p class="text-zinc-300 text-xl md:text-2xl max-w-2xl mx-auto mb-4 leading-relaxed" style="font-weight:500">
        Vlastná platforma na kurzy, rezervácie alebo členstvo.<br class="hidden md:block"/>
        Bez programovania. Bez drahých agentúr.
      </p>
      <p class="text-zinc-500 text-base mb-12">
        Spustíme za <strong class="text-zinc-300">7–14 dní</strong>. Platíš len za výsledok.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mb-16">
        <a href="#kontakt" class="group bg-indigo-600 hover:bg-indigo-500 text-white font-black px-10 py-5 rounded-2xl transition-all duration-200 shadow-xl shadow-indigo-900/50 cursor-pointer text-xl">
          Chcem vlastnú platformu
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1"> →</span>
        </a>
      </div>
      <p class="text-zinc-600 text-sm">Bezplatný úvodný hovor · Žiadne záväzky</p>

      <!-- social proof bar -->
      <div class="mt-16 flex flex-wrap justify-center gap-0 border border-white/8 rounded-2xl overflow-hidden bg-white/[0.02] max-w-2xl mx-auto">
        {[
          {n:'7 dní',l:'od nápadu k spusteniu'},
          {n:'1 platforma',l:'už beží naplno'},
          {n:'100%',l:'váš vlastný kód'},
        ].map(({n,l}, i) => (
          <div class={`flex-1 min-w-[140px] px-6 py-5 text-center ${i < 2 ? 'border-r border-white/8' : ''}`}>
            <div class="font-black text-2xl text-white tracking-tight">{n}</div>
            <div class="text-zinc-500 text-xs mt-1 font-medium">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRE KOHO -->
  <section id="pre-koho" class="py-32 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">

      <div class="text-center mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Pre koho to je</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em]" style="font-size:clamp(2rem,5vw,4rem)">
          Spoznávaš sa?
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 mb-12">
        {[
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>`,
            color: 'indigo',
            who: 'Lektor / kouč',
            what: 'Chceš predávať kurzy online, ale nevieš ako. Posielaš PDF-ka emailom a platby cez QR kód.',
            want: 'Vlastná platforma kde si klient kúpi kurz, zaplatí a má prístup — automaticky.',
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.701-.393 2.25-1.016a2.992 2.992 0 002.25 1.016 2.993 2.993 0 003.75.615m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z"/>`,
            color: 'violet',
            who: 'Podnikateľ s nápadom',
            what: 'Máš skvelý nápad na aplikáciu alebo platformu, ale programovanie nevieš a agentúry chcú tisíce.',
            want: 'MVP za rozumné peniaze, rýchlo. Aby si mohol otestovať či to ľudia chcú.',
          },
          {
            icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 9v7.5m-9-6h.008v.008H12V13.5zm0 3h.008v.008H12v-.008zm0 3h.008v.008H12v-.008zm-3-6h.008v.008H9V13.5zm0 3h.008v.008H9v-.008zm0 3h.008v.008H9v-.008zm6-6h.008v.008h-.008V13.5zm0 3h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008z"/>`,
            color: 'emerald',
            who: 'Freelancer / expert',
            what: 'Predávaš čas za peniaze. Chceš pasívny príjem ale nevieš kde začať s digitálnymi produktmi.',
            want: 'Platforma na predaj tvojich znalostí — kurzy, členstvo, konzultácie online.',
          },
        ].map(({icon, color, who, what, want}) => (
          <div class={`bg-zinc-900/40 border border-white/6 rounded-3xl p-8 hover:border-${color}-500/30 transition-all duration-200`}>
            <div class={`w-12 h-12 rounded-2xl bg-${color}-600/15 border border-${color}-500/25 flex items-center justify-center mb-5`}>
              <svg class={`w-6 h-6 text-${color}-400`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icon}></svg>
            </div>
            <div class={`text-[10px] font-black text-${color}-400 uppercase tracking-[0.18em] mb-2`}>{who}</div>
            <p class="text-zinc-400 text-sm leading-relaxed mb-4">"{what}"</p>
            <div class="border-t border-white/6 pt-4">
              <p class="text-zinc-300 text-sm font-semibold leading-relaxed">
                <span class={`text-${color}-400`}>→ </span>{want}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="#kontakt" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-4 rounded-2xl transition-all duration-200 cursor-pointer text-lg shadow-lg shadow-indigo-900/40">
          Áno, toto je pre mňa →
        </a>
      </div>
    </div>
  </section>

  <!-- ČO DOSTANEM — PRICING OVERVIEW -->
  <section id="cena" class="py-32 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">

      <div class="text-center mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Čo dostanem</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em] mb-5" style="font-size:clamp(2rem,5vw,4rem)">
          Hotová platforma.<br />Nie len webstránka.
        </h2>
        <p class="text-zinc-400 text-lg max-w-xl mx-auto">Webstránka ti predá. Platforma ti zarobí. Rozdiel je obrovský.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-12">

        <!-- Basic -->
        <div class="bg-zinc-900/40 border border-white/6 rounded-3xl p-8 card-glow flex flex-col">
          <div class="text-[10px] font-black text-zinc-400 uppercase tracking-[0.18em] mb-2">Základ</div>
          <h3 class="font-black text-2xl text-white mb-1 tracking-tight">Platforma na kľúč</h3>
          <p class="text-zinc-400 text-sm mb-6">Pre lektorov, koučov a expertov čo chcú predávať online.</p>
          <ul class="space-y-3 text-sm text-zinc-300 mb-8 flex-1">
            {[
              'Prihlasovanie zákazníkov (email + heslo)',
              'Predaj kurzov alebo lekcií online',
              'Zákazník zaplatí → okamžitý prístup',
              'Tvoj admin panel — pridáš kurz za 2 min',
              'Funguje na mobile aj počítači',
              'Vlastná doména (napr. kurzy.tvoje-meno.sk)',
              'Hosting zadarmo (platíš len doménu ~10€/rok)',
            ].map(i => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
          <a href="#kontakt" class="block text-center bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-4 rounded-2xl transition-all duration-200 cursor-pointer">
            Chcem toto →
          </a>
        </div>

        <!-- Full service -->
        <div class="bg-gradient-to-b from-indigo-900/50 to-violet-900/30 border border-indigo-500/25 rounded-3xl p-8 card-glow flex flex-col relative">
          <div class="absolute -top-3 left-8 bg-indigo-600 text-white text-[10px] font-black px-3 py-1 rounded-full tracking-wider uppercase shadow-lg shadow-indigo-900/50">
            Odporúčam
          </div>
          <div class="text-[10px] font-black text-indigo-300 uppercase tracking-[0.18em] mb-2">Komplet balík</div>
          <h3 class="font-black text-2xl text-white mb-1 tracking-tight">Platforma + spustenie</h3>
          <p class="text-zinc-400 text-sm mb-6">Pre tých čo chcú výsledky, nie len technológiu.</p>
          <ul class="space-y-3 text-sm text-zinc-300 mb-8 flex-1">
            {[
              'Všetko zo základného balíka',
              'Platobná brána — zákazník zaplatí kartou',
              'Automatický email po kúpe kurzu',
              'Dizajn podľa tvojho brangu (logo, farby)',
              'Kvízy a testy pre študentov',
              'Štatistiky — koľko ľudí, koľko zarobíš',
              'Launch pack — prvé posty na sociálne siete',
              'Podpora 3 mesiace po spustení',
            ].map(i => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-violet-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
          <a href="#kontakt" class="block text-center bg-white text-zinc-900 hover:bg-zinc-100 font-black py-4 rounded-2xl transition-all duration-200 cursor-pointer">
            Chcem komplet balík →
          </a>
        </div>

      </div>

      <p class="text-center text-zinc-500 text-sm">
        Presná cena záleží od toho čo potrebuješ. Prvý hovor je vždy bezplatný.
      </p>

    </div>
  </section>

  <!-- AKO TO FUNGUJE -->
  <section id="ako-to-funguje" class="py-32 border-t border-white/5 overflow-hidden">
    <div class="max-w-5xl mx-auto px-6">

      <div class="text-center mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Ako to funguje</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em]" style="font-size:clamp(2rem,5vw,4rem)">
          Od hovoru<br />po spustenú platformu.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-4 mb-12">
        {[
          {n:'01',t:'Zavoláme si (zadarmo)',d:'30 minút. Povieš mi čo chceš predávať a komu. Ja ti poviem čo presne postavím a za koľko. Žiadne záväzky.', c:'indigo'},
          {n:'02',t:'Ukážem ti ako to bude vyzerať',d:'Pred tým ako začnem kódovať, ukážem ti dizajn. Schváliš to, navrhneš zmeny — až potom idem ďalej.', c:'violet'},
          {n:'03',t:'Staviam — ty čakáš 7–14 dní',d:'Budujem celú platformu. Priebežne ti ukazujem pokrok. Nemusíš rozumieť technológii — len povieš čo sa ti páči.', c:'purple'},
          {n:'04',t:'Spustíme a zaškolíme ťa',d:'Platforma ide live. Ukážem ti ako pridať kurz, pozrieť platby, komunikovať so zákazníkmi. Zvládneš to sama.', c:'emerald'},
        ].map(({n,t,d,c}) => (
          <div class={`group relative bg-zinc-900/40 border border-white/6 rounded-3xl p-8 hover:border-${c}-500/30 transition-all duration-200 overflow-hidden`}>
            <div class={`absolute -top-6 -right-4 font-black text-[8rem] text-${c}-900/40 leading-none select-none`} aria-hidden="true">{n}</div>
            <div class="relative">
              <div class={`text-[10px] font-black text-${c}-400 uppercase tracking-[0.18em] mb-3`}>Krok {n}</div>
              <h3 class="font-black text-xl tracking-tight text-white mb-3">{t}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{d}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center">
        <a href="#kontakt" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-4 rounded-2xl transition-all duration-200 cursor-pointer text-lg shadow-lg shadow-indigo-900/40">
          Začnime prvým hovorom →
        </a>
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="py-32 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">

      <div class="text-center mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Reálny príklad</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em]" style="font-size:clamp(2rem,5vw,4rem)">
          Toto som<br />
          <span class="gradient-text">už postavil.</span>
        </h2>
      </div>

      <div class="bg-gradient-to-br from-indigo-950/70 to-violet-950/50 border border-indigo-500/20 rounded-3xl p-8 md:p-12 relative overflow-hidden">
        <div class="blob w-80 h-80 bg-indigo-700 top-[-60px] right-[-60px]" style="animation-duration:11s;opacity:0.1"></div>
        <div class="relative grid md:grid-cols-2 gap-10 items-start">
          <div>
            <div class="inline-flex items-center gap-2 bg-white/6 border border-white/10 rounded-full px-3 py-1 text-xs text-zinc-400 font-medium mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Spustené · 2025
            </div>
            <h3 class="font-black text-3xl tracking-tight text-white mb-4 leading-tight">Platforma pre lektorku jazykov</h3>
            <p class="text-zinc-400 text-sm leading-relaxed mb-6">
              Lektorka angličtiny a španielčiny chcela predávať kurzy online. Predtým posielala materiály emailom a platby riešila ručne. Dnes má vlastnú platformu kde zákazníci platia kartou a majú okamžitý prístup k lekciám.
            </p>
            <div class="grid grid-cols-2 gap-3">
              {[{n:'2 týždne',l:'od nápadu po spustenie'},{n:'0 €',l:'mesačné náklady na hosting'},{n:'100%',l:'jej vlastná platforma'},{n:'Stripe',l:'platby kartou v pár krokoch'}].map(({n,l}) => (
                <div class="bg-white/5 border border-white/8 rounded-2xl p-4">
                  <div class="font-black text-white text-sm tracking-tight">{n}</div>
                  <div class="text-zinc-500 text-xs mt-0.5 font-medium">{l}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="space-y-3">
            <p class="text-xs font-black text-zinc-500 uppercase tracking-[0.15em] mb-4">Čo dostala</p>
            {[
              'Zákazník sa zaregistruje sám — bez nej',
              'Zaplatí kartou — peniaze idú priamo jej',
              'Okamžitý prístup k lekciám po platbe',
              'Kvízy a testy — vidí pokrok študenta',
              'Ona pridáva kurzy sama, za 2 minúty',
              'Funguje na mobile aj počítači',
              'Vlastná doména a dizajn podľa nej',
            ].map(f => (
              <div class="flex items-center gap-3 text-sm text-zinc-300 bg-white/[0.03] border border-white/6 rounded-xl px-4 py-3">
                <div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                {f}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- REFERENCIE -->
  <section id="referencie" class="py-32 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Referencie</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em] mb-5" style="font-size:clamp(2rem,5vw,4rem)">
          Weby, čo už <span class="gradient-text">bežia.</span>
        </h2>
        <p class="text-zinc-400 text-lg max-w-xl mx-auto">Skutočné stránky pre skutočných klientov. Klikni a pozri si ich naživo.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {[
          {img:'/portfolio/kadernictvomi.png', name:'Capillus kaderníctvo', cat:'Kaderníctvo · Michalovce', url:'https://kadernictvomi.sk'},
          {img:'/portfolio/rozbitymobil.png', name:'Rozbitý mobil', cat:'Servis elektroniky · Michalovce', url:'https://rozbitymobil.sk'},
          {img:'/portfolio/lekaren.png', name:'Medical Center Pharmacy', cat:'Lekáreň · Sečovce', url:'https://lekarensecovce.sk'},
        ].map(({img, name, cat, url}) => (
          <a href={url} target="_blank" rel="noopener" class="group bg-zinc-900/40 border border-white/6 rounded-3xl overflow-hidden hover:border-indigo-500/40 transition-all duration-200 cursor-pointer flex flex-col">
            <div class="relative overflow-hidden aspect-[16/10] border-b border-white/6">
              <img src={img} alt={`Náhľad webu ${name}`} loading="lazy" width="1280" height="800" class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.04]" />
            </div>
            <div class="p-6 flex items-center justify-between gap-4">
              <div>
                <div class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.15em] mb-1.5">{cat}</div>
                <h3 class="font-black text-lg text-white tracking-tight">{name}</h3>
              </div>
              <svg class="w-5 h-5 text-zinc-500 shrink-0 transition-all duration-200 group-hover:text-indigo-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7V17"/>
              </svg>
            </div>
          </a>
        ))}
