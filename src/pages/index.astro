---
import Layout from '../layouts/Layout.astro';
---
<Layout>

  <!-- FLOATING NAV -->
  <nav class="fixed top-4 left-4 right-4 z-50 rounded-2xl border border-white/8 bg-[#030712]/70 backdrop-blur-2xl">
    <div class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between">
      <a href="/" class="font-black text-lg tracking-tight cursor-pointer">
        Smart<span class="text-indigo-400">Agency</span><span class="text-indigo-400">.</span>
      </a>
      <div class="hidden md:flex items-center gap-7 text-sm text-zinc-400">
        <a href="#sluzby" class="hover:text-white transition-colors duration-200 cursor-pointer">Služby</a>
        <a href="#process" class="hover:text-white transition-colors duration-200 cursor-pointer">Proces</a>
        <a href="#kurzy" class="hover:text-white transition-colors duration-200 cursor-pointer">Kurzy</a>
        <a href="#kontakt" class="hover:text-white transition-colors duration-200 cursor-pointer">Kontakt</a>
      </div>
      <a href="#kontakt" class="bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-bold px-5 py-2 rounded-xl transition-all duration-200 cursor-pointer shadow-lg shadow-indigo-900/40">
        Začnime →
      </a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center overflow-hidden pt-24">
    <div class="blob w-[600px] h-[600px] bg-indigo-600 top-[-150px] right-[-200px]" style="animation-duration:10s"></div>
    <div class="blob w-[450px] h-[450px] bg-violet-700 bottom-[-120px] left-[-120px]" style="animation-duration:13s;animation-delay:4s"></div>
    <div class="blob w-[350px] h-[350px] bg-purple-500 top-[35%] left-[35%]" style="animation-duration:17s;animation-delay:7s"></div>

    <!-- grid overlay -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image:linear-gradient(white 1px,transparent 1px),linear-gradient(90deg,white 1px,transparent 1px);background-size:72px 72px"></div>

    <div class="relative max-w-6xl mx-auto px-6 py-32 text-center">

      <!-- badge -->
      <div class="inline-flex items-center gap-2 border border-indigo-500/25 bg-indigo-500/8 rounded-full px-4 py-1.5 text-xs font-semibold text-indigo-300 mb-10 relative">
        <span class="relative flex w-2 h-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-60"></span>
          <span class="relative inline-flex w-2 h-2 rounded-full bg-indigo-400"></span>
        </span>
        Dostupný pre nových klientov · Slovensko & remote
      </div>

      <!-- EXAGGERATED heading -->
      <h1 class="font-black leading-[0.92] tracking-[-0.04em] mb-8" style="font-size:clamp(3rem,8.5vw,7.5rem)">
        Digitálne<br />
        platformy<br />
        <span class="gradient-text">s AI.</span>
      </h1>

      <p class="text-zinc-400 text-lg md:text-xl max-w-xl mx-auto mb-12 leading-relaxed" style="font-weight:400">
        SaaS, e-learning, booking. Rýchlo, moderne.<br class="hidden md:block" />
        Bez zbytočných nákladov.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mb-24">
        <a href="#kontakt" class="group bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-8 py-4 rounded-2xl transition-all duration-200 shadow-xl shadow-indigo-900/50 cursor-pointer text-lg">
          Chcem platformu
          <span class="inline-block transition-transform duration-200 group-hover:translate-x-1"> →</span>
        </a>
        <a href="#kurzy" class="border border-white/12 text-zinc-300 hover:bg-white/5 hover:text-white font-semibold px-8 py-4 rounded-2xl transition-all duration-200 cursor-pointer text-lg">
          Pozrieť kurzy
        </a>
      </div>

      <!-- stats -->
      <div class="inline-flex flex-wrap justify-center gap-0 border border-white/8 rounded-2xl overflow-hidden bg-white/[0.02]">
        {[
          {n:'7 dní',l:'od nápadu k MVP'},
          {n:'AI-first',l:'vývoj aj dizajn'},
          {n:'100%',l:'váš vlastný kód'},
        ].map(({n,l}, i) => (
          <div class={`px-10 py-5 text-center ${i < 2 ? 'border-r border-white/8' : ''}`}>
            <div class="font-black text-2xl md:text-3xl text-white tracking-tight">{n}</div>
            <div class="text-zinc-500 text-xs mt-1 font-medium">{l}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section id="sluzby" class="py-32 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-20">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Čo robím</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em] mb-5" style="font-size:clamp(2.2rem,5vw,4.5rem)">
          Tri spôsoby<br />ako ti pomôžem.
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed">Vyberám si projekty kde môžem urobiť skutočný rozdiel — nie šablóny, nie kompromisy.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">

        <!-- Development -->
        <div class="group bg-zinc-900/40 border border-white/6 rounded-3xl p-8 card-glow flex flex-col">
          <div class="w-12 h-12 rounded-2xl bg-indigo-600/15 border border-indigo-500/25 flex items-center justify-center mb-6 group-hover:bg-indigo-600/25 transition-colors duration-200">
            <svg class="w-6 h-6 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>
            </svg>
          </div>
          <div class="text-[10px] font-black text-indigo-400 uppercase tracking-[0.18em] mb-3">Development</div>
          <h3 class="font-black text-2xl tracking-tight text-white mb-3 leading-tight">Platformy<br />na mieru</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">E-learningové systémy, SaaS aplikácie, booking platformy. Next.js + Supabase + moderný dizajn.</p>
          <ul class="space-y-2.5 text-sm text-zinc-400 border-t border-white/6 pt-6">
            {['Databáza + autentifikácia','Admin & používateľský panel','Platobná brána (Stripe)','Deploy na Vercel'].map(i => (
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-indigo-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
        </div>

        <!-- Full-service — POPULAR -->
        <div class="group bg-gradient-to-b from-indigo-900/50 to-violet-900/30 border border-indigo-500/25 rounded-3xl p-8 card-glow flex flex-col relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-indigo-600 text-white text-[10px] font-black px-3 py-1 rounded-full tracking-wider uppercase shadow-lg shadow-indigo-900/50">
            Populárne
          </div>
          <div class="w-12 h-12 rounded-2xl bg-violet-600/15 border border-violet-500/25 flex items-center justify-center mb-6 group-hover:bg-violet-600/25 transition-colors duration-200">
            <svg class="w-6 h-6 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
            </svg>
          </div>
          <div class="text-[10px] font-black text-violet-400 uppercase tracking-[0.18em] mb-3">Full-service</div>
          <h3 class="font-black text-2xl tracking-tight text-white mb-3 leading-tight">Platforma<br />+ spustenie</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Kompletné riešenie — vývoj, dizajn, sociálne siete až po prvých klientov. Robím všetko.</p>
          <ul class="space-y-2.5 text-sm text-zinc-400 border-t border-white/10 pt-6">
            {['Celý vývoj platformy','UI/UX dizajn (Canva Pro)','Sociálne siete — launch pack','Podpora 3 mesiace'].map(i => (
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-violet-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
        </div>

        <!-- Courses -->
        <div class="group bg-zinc-900/40 border border-white/6 rounded-3xl p-8 card-glow flex flex-col">
          <div class="w-12 h-12 rounded-2xl bg-emerald-600/15 border border-emerald-500/25 flex items-center justify-center mb-6 group-hover:bg-emerald-600/25 transition-colors duration-200">
            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
            </svg>
          </div>
          <div class="text-[10px] font-black text-emerald-400 uppercase tracking-[0.18em] mb-3">Vzdelávanie</div>
          <h3 class="font-black text-2xl tracking-tight text-white mb-3 leading-tight">Kurzy<br />& návody</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Nauč sa stavať vlastné platformy s AI. Od nuly — bez predchádzajúcich skúseností.</p>
          <ul class="space-y-2.5 text-sm text-zinc-400 border-t border-white/6 pt-6">
            {['Next.js + Supabase od základov','Dizajn bez dizajnéra','AI nástroje v praxi','Reálny projekt ako case study'].map(i => (
              <li class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                {i}
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- PROCESS — Scroll storytelling chapters -->
  <section id="process" class="py-32 border-t border-white/5 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-20">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Ako to funguje</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em]" style="font-size:clamp(2.2rem,5vw,4.5rem)">
          Od nápadu<br />k platforme<br />
          <span class="gradient-text">za 7–14 dní.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-4">
        {[
          {n:'01',t:'Úvodný hovor',d:'30 minút. Prejdeme tvoj nápad a ciele. Žiadne záväzky — len otvorený rozhovor o tom, čo potrebuješ.',c:'indigo'},
          {n:'02',t:'Návrh & dizajn',d:'Pripravím UI dizajn a architektúru. Uvidíš ako bude platforma vyzerať ešte pred tým, ako napíšem prvý riadok kódu.',c:'violet'},
          {n:'03',t:'Vývoj s AI',d:'Staviam rýchlo s AI nástrojmi — Next.js, Supabase, moderný dizajn. Priebežne ti ukazujem pokrok.',c:'purple'},
          {n:'04',t:'Odovzdanie & podpora',d:'Deploy na Vercel, vlastná doména, všetky prístupy sú tvoje. Podpora a zaškolenie po spustení.',c:'emerald'},
        ].map(({n,t,d,c}) => (
          <div class={`group relative bg-zinc-900/40 border border-white/6 rounded-3xl p-8 hover:border-${c}-500/30 transition-all duration-200 cursor-default overflow-hidden`}>
            <div class={`absolute -top-4 -right-4 font-black text-[9rem] text-${c}-900/30 leading-none select-none`} aria-hidden="true">{n}</div>
            <div class="relative">
              <div class={`text-[10px] font-black text-${c}-400 uppercase tracking-[0.18em] mb-3`}>Krok {n}</div>
              <h3 class="font-black text-2xl tracking-tight text-white mb-3">{t}</h3>
              <p class="text-zinc-400 text-sm leading-relaxed">{d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CASE STUDY -->
  <section class="py-32 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-16">
        <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-4">Case study</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em] mb-5" style="font-size:clamp(2.2rem,5vw,4.5rem)">
          Reálna platforma.<br />
          <span class="gradient-text">Reálny výsledok.</span>
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed">Jazyková platforma pre lektorku angličtiny a španielčiny — od nuly po spustenie za menej ako 2 týždne.</p>
      </div>

      <div class="bg-gradient-to-br from-indigo-950/70 to-violet-950/50 border border-indigo-500/20 rounded-3xl p-8 md:p-12 relative overflow-hidden">
        <div class="blob w-96 h-96 bg-indigo-700 top-[-80px] right-[-80px]" style="animation-duration:11s;opacity:0.12"></div>
        <div class="relative grid md:grid-cols-2 gap-10 items-start">

          <div>
            <div class="inline-flex items-center gap-2 bg-white/6 border border-white/10 rounded-full px-3 py-1 text-xs text-zinc-400 font-medium mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              E-learning platforma · 2025
            </div>
            <h3 class="font-black text-3xl md:text-4xl tracking-tight text-white mb-4 leading-tight">Jazykové kurzy<br />pre lektorku</h3>
            <p class="text-zinc-400 text-sm leading-relaxed mb-8">Admin panel, systém pozvánia, interaktívne kvízy, sledovanie pokroku. Kompletné riešenie od dizajnu po spustenie.</p>

            <div class="grid grid-cols-2 gap-3">
              {[{n:'2 týždne',l:'čas vývoja'},{n:'Next.js 16',l:'frontend'},{n:'Supabase',l:'backend + auth'},{n:'Vercel',l:'hosting'}].map(({n,l}) => (
                <div class="bg-white/5 border border-white/8 rounded-2xl p-4">
                  <div class="font-black text-white text-sm tracking-tight">{n}</div>
                  <div class="text-zinc-500 text-xs mt-0.5 font-medium">{l}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="space-y-3">
            <p class="text-xs font-black text-zinc-500 uppercase tracking-[0.15em] mb-5">Čo sme postavili</p>
            {[
              'Admin panel s CRUD kurzov a lekcií',
              'Systém pozvánia cez email (Resend)',
              'Kvízový systém — MCQ, True/False, Fill-in',
              'SVG progress ring — pokrok študenta',
              'Supabase Auth + RLS bezpečnostné pravidlá',
              'Moderný dark dizajn — bento grid layout',
              'Responzívny dizajn pre mobil aj desktop',
            ].map(f => (
              <div class="flex items-center gap-3 text-sm text-zinc-300 bg-white/[0.03] border border-white/6 rounded-xl px-4 py-3">
                <div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center shrink-0">
                  <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                {f}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- COURSES -->
  <section id="kurzy" class="py-32 border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6">

      <div class="max-w-2xl mb-20">
        <p class="text-xs font-black text-emerald-400 tracking-[0.2em] uppercase mb-4">Kurzy</p>
        <h2 class="font-black leading-[1.05] tracking-[-0.03em] mb-5" style="font-size:clamp(2.2rem,5vw,4.5rem)">
          Nauč sa to sám.
        </h2>
        <p class="text-zinc-400 text-lg leading-relaxed">Praktické návody. Žiadna teória — len to, čo reálne funguje v praxi.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">

        <div class="group bg-zinc-900/40 border border-white/6 rounded-3xl overflow-hidden card-glow flex flex-col">
          <div class="bg-gradient-to-br from-indigo-600 to-violet-700 p-10 relative overflow-hidden">
            <div class="absolute -bottom-4 -right-4 font-black text-[8rem] text-white/8 leading-none select-none" aria-hidden="true">01</div>
            <div class="relative">
              <div class="text-[10px] font-black text-indigo-200 uppercase tracking-[0.18em] mb-4">Kurz 01</div>
              <h3 class="font-black text-2xl md:text-3xl text-white leading-tight tracking-tight">Postav si vlastnú<br />SaaS platformu</h3>
            </div>
          </div>
          <div class="p-8 flex flex-col flex-1">
            <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Kompletný návod od nuly — databáza, autentifikácia, admin panel, platby. Rovnaký stack ako pri reálnych projektoch.</p>
            <div class="flex items-center justify-between">
              <div class="font-black text-2xl text-zinc-600 tracking-tight">Čoskoro</div>
              <button class="bg-white/6 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all duration-200 cursor-pointer">
                Zaregistrovať záujem
              </button>
            </div>
          </div>
        </div>

        <div class="group bg-zinc-900/40 border border-white/6 rounded-3xl overflow-hidden card-glow flex flex-col">
          <div class="bg-gradient-to-br from-emerald-600 to-teal-700 p-10 relative overflow-hidden">
            <div class="absolute -bottom-4 -right-4 font-black text-[8rem] text-white/8 leading-none select-none" aria-hidden="true">02</div>
            <div class="relative">
              <div class="text-[10px] font-black text-emerald-200 uppercase tracking-[0.18em] mb-4">Kurz 02</div>
              <h3 class="font-black text-2xl md:text-3xl text-white leading-tight tracking-tight">AI nástroje<br />pre podnikateľov</h3>
            </div>
          </div>
          <div class="p-8 flex flex-col flex-1">
            <p class="text-zinc-400 text-sm leading-relaxed mb-6 flex-1">Reálne AI workflow — weby, platformy, obsah, automatizácia. Reálne projekty, reálne výsledky. Bez zbytočnej teórie.</p>
            <div class="flex items-center justify-between">
              <div class="font-black text-2xl text-zinc-600 tracking-tight">Čoskoro</div>
              <button class="bg-white/6 hover:bg-white/10 border border-white/10 text-zinc-300 hover:text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-all duration-200 cursor-pointer">
                Zaregistrovať záujem
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CONTACT CTA -->
  <section id="kontakt" class="py-32 border-t border-white/5">
    <div class="max-w-5xl mx-auto px-6">
      <div class="relative bg-gradient-to-br from-indigo-950/90 to-violet-950/70 border border-indigo-500/20 rounded-3xl p-12 md:p-20 text-center overflow-hidden">
        <div class="blob w-[400px] h-[400px] bg-indigo-600 top-[-100px] right-[-100px]" style="animation-duration:9s;opacity:0.1"></div>
        <div class="blob w-[300px] h-[300px] bg-violet-700 bottom-[-80px] left-[-60px]" style="animation-duration:12s;animation-delay:3s;opacity:0.08"></div>
        <div class="relative">
          <p class="text-xs font-black text-indigo-400 tracking-[0.2em] uppercase mb-6">Porozprávajme sa</p>
          <h2 class="font-black leading-[1.0] tracking-[-0.04em] text-white mb-6" style="font-size:clamp(2.5rem,6vw,6rem)">
            Máš nápad?
          </h2>
          <p class="text-zinc-400 text-lg md:text-xl mb-10 max-w-lg mx-auto leading-relaxed">
            Bezplatný 30-minútový hovor. Zistíme či a ako ti viem pomôcť. Žiadne záväzky.
          </p>
          <a href="mailto:martin@smartagency.sk" class="inline-flex items-center gap-3 bg-white text-zinc-900 font-black px-10 py-5 rounded-2xl transition-all duration-200 hover:bg-zinc-100 cursor-pointer text-lg shadow-2xl shadow-indigo-900/50">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Napísať mi
          </a>
          <p class="text-zinc-600 text-sm mt-6 font-medium">martin@smartagency.sk · Odpoviem do 24h</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="border-t border-white/5 py-10">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-zinc-600">
      <span class="font-black text-zinc-400">Smart<span class="text-indigo-500">Agency</span><span class="text-indigo-500">.</span></span>
      <span>© {new Date().getFullYear()} · Slovensko · Postavené s AI</span>
